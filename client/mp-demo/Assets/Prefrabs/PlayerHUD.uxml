<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="hud-root" style="flex-grow: 1; width: 100%; height: 100%; position: relative;">
        <ui:VisualElement name="round-phase-container" style="position: absolute; left: 50%; top: 20px; translate: -50% 0; align-items: center; display: none;">
            <ui:Label name="round-phase-title-label" text="INTERMISSION" style="color: rgb(168, 216, 255); background-color: rgba(8, 14, 22, 0.86); padding-left: 16px; padding-right: 16px; padding-top: 6px; padding-bottom: 4px; border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-left-radius: 10px; border-bottom-right-radius: 10px; font-size: 20px; -unity-font-style: bold; unity-text-align: middle-center;"/>
            <ui:Label name="round-phase-timer-label" text="0:30" style="margin-top: 6px; color: rgb(255, 255, 255); font-size: 32px; -unity-font-style: bold; unity-text-align: middle-center;"/>
        </ui:VisualElement>
        <ui:VisualElement name="round-announcement-container" style="position: absolute; left: 50%; top: 132px; translate: -50% 0; width: 100%; max-width: 680px; padding-left: 20px; padding-right: 20px; align-items: center; display: none;">
            <ui:Label name="round-announcement-title-label" text="ROUND STARTED" style="color: rgb(255, 118, 118); font-size: 18px; -unity-font-style: bold; unity-text-align: middle-center;"/>
            <ui:Label name="round-announcement-subtitle-label" text="SURVIVE FOR 3 MINUTES" style="margin-top: 4px; color: rgb(255, 220, 158); font-size: 40px; -unity-font-style: bold; unity-text-align: middle-center;"/>
        </ui:VisualElement>
        <ui:Label name="speed-label" text="Speed 0.0" style="position: absolute; left: 28px; bottom: 24px; color: rgb(255, 255, 255); background-color: rgba(0, 0, 0, 0.45); padding-left: 14px; padding-right: 14px; padding-top: 8px; padding-bottom: 8px; border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-left-radius: 10px; border-bottom-right-radius: 10px; font-size: 22px; -unity-font-style: bold;"/>
        <ui:VisualElement name="local-health-container" style="display: none; position: absolute; left: 28px; top: 24px; width: 280px; padding-left: 14px; padding-right: 14px; padding-top: 12px; padding-bottom: 12px; background-color: rgba(8, 10, 14, 0.76); border-top-left-radius: 12px; border-top-right-radius: 12px; border-bottom-left-radius: 12px; border-bottom-right-radius: 12px; border-left-width: 1px; border-right-width: 1px; border-top-width: 1px; border-bottom-width: 1px; border-left-color: rgba(255,255,255,0.08); border-right-color: rgba(255,255,255,0.08); border-top-color: rgba(255,255,255,0.08); border-bottom-color: rgba(255,255,255,0.08);">
            <ui:VisualElement style="flex-direction: row; justify-content: space-between; align-items: center;">
                <ui:Label text="HEALTH" style="color: rgba(255,255,255,0.82); font-size: 14px; -unity-font-style: bold; letter-spacing: 1px;"/>
                <ui:Label name="local-health-label" text="100 / 100" style="color: rgb(255,255,255); font-size: 18px; -unity-font-style: bold; unity-text-align: middle-right;"/>
            </ui:VisualElement>
            <ui:VisualElement style="margin-top: 10px; height: 14px; background-color: rgba(255,255,255,0.12); border-top-left-radius: 999px; border-top-right-radius: 999px; border-bottom-left-radius: 999px; border-bottom-right-radius: 999px; overflow: hidden;">
                <ui:VisualElement name="local-health-fill" style="height: 100%; width: 100%; background-color: rgb(94, 222, 109); border-top-left-radius: 999px; border-top-right-radius: 999px; border-bottom-left-radius: 999px; border-bottom-right-radius: 999px;"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Label name="ammo-label" text="30 / 30" style="display: none; position: absolute; right: 28px; bottom: 24px; color: rgb(255, 238, 206); background-color: rgba(8, 10, 14, 0.76); padding-left: 16px; padding-right: 16px; padding-top: 10px; padding-bottom: 10px; border-top-left-radius: 12px; border-top-right-radius: 12px; border-bottom-left-radius: 12px; border-bottom-right-radius: 12px; border-left-width: 1px; border-right-width: 1px; border-top-width: 1px; border-bottom-width: 1px; border-left-color: rgba(255,255,255,0.08); border-right-color: rgba(255,255,255,0.08); border-top-color: rgba(255,255,255,0.08); border-bottom-color: rgba(255,255,255,0.08); font-size: 24px; -unity-font-style: bold; unity-text-align: middle-center; letter-spacing: 1px;"/>
        <ui:VisualElement name="enemy-health-overlay" picking-mode="Ignore" style="position: absolute; left: 0; top: 0; right: 0; bottom: 0;"/>
        <ui:VisualElement name="crosshair-dot" style="position: absolute; left: 50%; top: 50%; width: 8px; height: 8px; translate: -50% -50%; background-color: rgb(255, 255, 255); border-top-left-radius: 999px; border-top-right-radius: 999px; border-bottom-left-radius: 999px; border-bottom-right-radius: 999px; opacity: 0.95;"/>
        <ui:VisualElement name="nextbot-warning-indicator" picking-mode="Ignore" style="display: none; position: absolute; left: 50%; top: 50%; width: 96px; height: 96px; translate: -50% -50%; opacity: 0.9;">
            <ui:VisualElement name="nextbot-warning-skull" style="display: none;"/>
            <ui:VisualElement name="nextbot-warning-arrow" style="position: absolute; left: 50%; top: 50%; width: 34px; height: 34px; translate: -50% -50%;"/>
        </ui:VisualElement>
        <ui:VisualElement name="injured-interaction-prompt" style="display: none; position: absolute; left: 50%; bottom: 112px; translate: -50% 0; min-width: 248px; row-gap: 40px;">
            <ui:VisualElement name="revive-action-row" style="position: relative; flex-direction: row; align-items: center; min-height: 34px; background-color: rgba(12, 12, 12, 0.55); overflow: hidden; border-top-left-radius: 4px; border-top-right-radius: 4px; border-bottom-left-radius: 4px; border-bottom-right-radius: 4px; border-left-width: 1px; border-right-width: 1px; border-top-width: 1px; border-bottom-width: 1px; border-left-color: rgba(224, 173, 98, 0.95); border-right-color: rgba(224, 173, 98, 0.95); border-top-color: rgba(224, 173, 98, 0.95); border-bottom-color: rgba(224, 173, 98, 0.95);">
                <ui:VisualElement name="revive-action-fill" style="position: absolute; left: 0; top: 0; bottom: 0; width: 0%; background-color: rgba(255, 255, 255, 0.22);"/>
                <ui:VisualElement style="position: relative; flex-direction: row; align-items: center; flex-grow: 1;">
                    <ui:Label text="[E]" style="width: 60px; color: rgb(255, 212, 138); font-size: 18px; -unity-font-style: bold; unity-text-align: middle-center; border-right-width: 1px; border-right-color: rgba(224, 173, 98, 0.95);"/>
                    <ui:Label text="-" style="width: 28px; color: rgb(255, 212, 138); font-size: 17px; unity-text-align: middle-center;"/>
                    <ui:Label text="Revive" style="flex-grow: 1; padding-right: 12px; color: rgb(255, 255, 255); font-size: 18px; -unity-font-style: bold; unity-text-align: middle-right;"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="carry-action-row" style="position: relative; flex-direction: row; align-items: center; min-height: 34px; background-color: rgba(12, 12, 12, 0.55); overflow: hidden; border-top-left-radius: 4px; border-top-right-radius: 4px; border-bottom-left-radius: 4px; border-bottom-right-radius: 4px; border-left-width: 1px; border-right-width: 1px; border-top-width: 1px; border-bottom-width: 1px; border-left-color: rgba(224, 173, 98, 0.95); border-right-color: rgba(224, 173, 98, 0.95); border-top-color: rgba(224, 173, 98, 0.95); border-bottom-color: rgba(224, 173, 98, 0.95);">
                <ui:VisualElement name="carry-action-fill" style="position: absolute; left: 0; top: 0; bottom: 0; width: 0%; background-color: rgba(255, 255, 255, 0.22);"/>
                <ui:VisualElement style="position: relative; flex-direction: row; align-items: center; flex-grow: 1;">
                    <ui:Label text="[Q]" style="width: 60px; color: rgb(255, 212, 138); font-size: 18px; -unity-font-style: bold; unity-text-align: middle-center; border-right-width: 1px; border-right-color: rgba(224, 173, 98, 0.95);"/>
                    <ui:Label text="-" style="width: 28px; color: rgb(255, 212, 138); font-size: 17px; unity-text-align: middle-center;"/>
                    <ui:Label text="Carry" style="flex-grow: 1; padding-right: 12px; color: rgb(255, 255, 255); font-size: 18px; -unity-font-style: bold; unity-text-align: middle-right;"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="pause-menu" style="display: none; position: absolute; left: 0; top: 0; right: 0; bottom: 0; align-items: center; justify-content: center; background-color: rgba(0, 0, 0, 0.35);">
            <ui:VisualElement name="pause-card" style="width: 860px; max-width: 94%; min-height: 640px; padding-left: 18px; padding-right: 18px; padding-top: 18px; padding-bottom: 18px; background-color: rgba(28, 10, 6, 0.9); border-top-left-radius: 14px; border-top-right-radius: 14px; border-bottom-left-radius: 14px; border-bottom-right-radius: 14px; border-left-width: 1px; border-right-width: 1px; border-top-width: 1px; border-bottom-width: 1px; border-left-color: rgba(255, 255, 255, 0.08); border-right-color: rgba(255, 255, 255, 0.08); border-top-color: rgba(255, 255, 255, 0.08); border-bottom-color: rgba(255, 255, 255, 0.08); align-items: stretch;">
                <ui:VisualElement style="flex-direction: row; justify-content: center; align-items: center; height: 52px; padding-left: 12px; padding-right: 12px; border-bottom-width: 1px; border-bottom-color: rgba(255, 255, 255, 0.12);">
                    <ui:Label text="Settings" style="color: rgb(255, 255, 255); font-size: 22px; -unity-font-style: bold; border-bottom-width: 2px; border-bottom-color: rgb(255, 255, 255); padding-bottom: 8px;"/>
                </ui:VisualElement>
                <ui:ScrollView mode="Vertical" horizontal-scroller-visibility="Hidden" style="flex-grow: 1; margin-top: 12px; margin-bottom: 16px;">
                    <ui:Label text="Audio" style="color: rgb(255, 255, 255); font-size: 22px; -unity-font-style: bold; margin-bottom: 12px;"/>
                    <ui:VisualElement style="flex-direction: row; align-items: center; min-height: 52px; padding-left: 12px; padding-right: 12px; background-color: rgba(50, 50, 50, 0.9); border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-left-radius: 10px; border-bottom-right-radius: 10px;">
                        <ui:Label text="Volume" style="width: 180px; color: rgb(255, 255, 255); font-size: 18px;"/>
                        <ui:SliderInt name="pause-volume-slider" low-value="0" high-value="10" page-size="1" show-input-field="false" style="flex-grow: 1;"/>
                    </ui:VisualElement>
                    <ui:Label text="Display &amp; Graphics" style="margin-top: 26px; color: rgb(255, 255, 255); font-size: 22px; -unity-font-style: bold; margin-bottom: 12px;"/>
                    <ui:VisualElement style="flex-direction: row; align-items: center; min-height: 52px; padding-left: 12px; padding-right: 12px; background-color: rgba(50, 50, 50, 0.9); border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-left-radius: 10px; border-bottom-right-radius: 10px;">
                        <ui:Label text="Graphics Quality" style="width: 180px; color: rgb(255, 255, 255); font-size: 18px;"/>
                        <ui:Button name="pause-graphics-low-button" text="Low" style="width: 120px; height: 40px; margin-right: 10px; color: rgb(255, 255, 255); background-color: rgba(77, 104, 58, 0.95); border-top-left-radius: 8px; border-top-right-radius: 8px; border-bottom-left-radius: 8px; border-bottom-right-radius: 8px; -unity-font-style: bold;"/>
                        <ui:Button name="pause-graphics-medium-button" text="Medium" style="width: 120px; height: 40px; color: rgb(255, 255, 255); background-color: rgba(82, 96, 138, 0.95); border-top-left-radius: 8px; border-top-right-radius: 8px; border-bottom-left-radius: 8px; border-bottom-right-radius: 8px; -unity-font-style: bold;"/>
                        <ui:Label name="pause-graphics-value-label" text="Medium" style="margin-left: 16px; flex-grow: 1; color: rgba(255, 255, 255, 0.8); font-size: 18px; unity-text-align: middle-right;"/>
                    </ui:VisualElement>
                </ui:ScrollView>
                <ui:VisualElement style="flex-direction: row; justify-content: space-between; align-items: center;">
                    <ui:Button name="main-menu-button" text="[L]  Leave" style="width: 31%; height: 52px; color: rgb(255, 255, 255); background-color: rgba(72, 54, 52, 0.96); border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-left-radius: 10px; border-bottom-right-radius: 10px; font-size: 18px; -unity-font-style: bold;"/>
                    <ui:Button name="respawn-button" text="[R]  Respawn" style="width: 31%; height: 52px; color: rgba(255, 255, 255, 0.58); background-color: rgba(72, 54, 52, 0.86); border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-left-radius: 10px; border-bottom-right-radius: 10px; font-size: 18px; -unity-font-style: bold;"/>
                    <ui:Button name="continue-button" text="[ESC]  Resume" style="width: 31%; height: 52px; color: rgb(255, 255, 255); background-color: rgb(45, 53, 133); border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-left-radius: 10px; border-bottom-right-radius: 10px; font-size: 18px; -unity-font-style: bold;"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="tab-scoreboard-overlay" picking-mode="Ignore" style="display: none; position: absolute; left: 0; top: 0; right: 0; bottom: 0; padding-left: 24px; padding-right: 24px; padding-top: 24px; padding-bottom: 24px; align-items: center; justify-content: center;">
            <ui:VisualElement name="tab-scoreboard-card" style="width: 720px; max-width: 92%; min-height: 520px; max-height: 88%; padding-left: 18px; padding-right: 18px; padding-top: 18px; padding-bottom: 18px; background-color: rgba(6, 6, 6, 0.76); border-top-left-radius: 8px; border-top-right-radius: 8px; border-bottom-left-radius: 8px; border-bottom-right-radius: 8px; border-left-width: 1px; border-right-width: 1px; border-top-width: 1px; border-bottom-width: 1px; border-left-color: rgba(215, 191, 144, 0.2); border-right-color: rgba(215, 191, 144, 0.2); border-top-color: rgba(215, 191, 144, 0.2); border-bottom-color: rgba(215, 191, 144, 0.2);">
                <ui:VisualElement style="height: 58px; align-items: center; justify-content: center; background-color: rgb(179, 156, 115); border-top-left-radius: 4px; border-top-right-radius: 4px; border-bottom-left-radius: 4px; border-bottom-right-radius: 4px;">
                <ui:Label text="PLAYERS" style="color: rgb(56, 48, 36); font-size: 28px; -unity-font-style: bold; unity-text-align: middle-center; letter-spacing: 1px;"/>
                </ui:VisualElement>
                <ui:VisualElement style="flex-direction: row; margin-top: 14px; padding-left: 10px; padding-right: 10px; padding-top: 6px; padding-bottom: 6px; background-color: rgba(0, 0, 0, 0.42);">
                    <ui:Label text="NAME" style="flex-grow: 1; color: rgba(255, 255, 255, 0.55); font-size: 15px; -unity-font-style: bold;"/>
                    <ui:Label text="STATE" style="width: 110px; color: rgba(255, 255, 255, 0.55); font-size: 15px; -unity-font-style: bold; unity-text-align: middle-center;"/>
                    <ui:Label text="READY" style="width: 88px; color: rgba(255, 255, 255, 0.55); font-size: 15px; -unity-font-style: bold; unity-text-align: middle-right;"/>
                </ui:VisualElement>
                <ui:ScrollView name="tab-scoreboard-list" mode="Vertical" vertical-scroller-visibility="Hidden" horizontal-scroller-visibility="Hidden" style="flex-grow: 1; margin-top: 4px; background-color: rgba(0, 0, 0, 0.14);"/>
                <ui:VisualElement style="flex-direction: row; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; margin-top: 14px; row-gap: 10px;">
                    <ui:VisualElement style="max-width: 48%;">
                        <ui:Label name="tab-scoreboard-map-label" text="Map: SampleScene" style="color: rgb(214, 189, 138); font-size: 17px; -unity-font-style: bold;"/>
                        <ui:Label name="tab-scoreboard-phase-label" text="Phase: Waiting" style="margin-top: 4px; color: rgb(214, 189, 138); font-size: 17px; -unity-font-style: bold;"/>
                    </ui:VisualElement>
                    <ui:VisualElement style="max-width: 48%; align-items: flex-end;">
                        <ui:Label name="tab-scoreboard-mode-label" text="Gamemode: Default" style="color: rgb(214, 189, 138); font-size: 17px; -unity-font-style: bold; unity-text-align: middle-right;"/>
                        <ui:Label name="tab-scoreboard-player-count-label" text="0 players" style="margin-top: 4px; color: rgb(214, 189, 138); font-size: 17px; -unity-font-style: bold; unity-text-align: middle-right;"/>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="round-results-overlay" style="display: none; position: absolute; left: 0; top: 0; right: 0; bottom: 0; align-items: center; justify-content: center; background-color: rgba(0, 0, 0, 0.36);">
            <ui:VisualElement name="round-results-card" style="width: 620px; max-width: 92%; max-height: 88%; padding-left: 24px; padding-right: 24px; padding-top: 22px; padding-bottom: 22px; background-color: rgba(12, 16, 22, 0.94); border-top-left-radius: 16px; border-top-right-radius: 16px; border-bottom-left-radius: 16px; border-bottom-right-radius: 16px; border-left-width: 1px; border-right-width: 1px; border-top-width: 1px; border-bottom-width: 1px; border-left-color: rgba(255, 255, 255, 0.08); border-right-color: rgba(255, 255, 255, 0.08); border-top-color: rgba(255, 255, 255, 0.08); border-bottom-color: rgba(255, 255, 255, 0.08); align-self: center;">
                <ui:Label name="round-results-title-label" text="SURVIVED" style="color: rgb(255, 193, 88); font-size: 44px; -unity-font-style: bold; unity-text-align: middle-center;"/>
                <ui:Label text="OVERVIEW" style="margin-top: 12px; color: rgb(255, 255, 255); font-size: 18px; -unity-font-style: bold;"/>
                <ui:VisualElement style="flex-direction: row; flex-wrap: wrap; margin-top: 10px; row-gap: 12px;">
                    <ui:VisualElement style="flex-grow: 1;">
                        <ui:Label text="BEST TIME" style="color: rgb(255, 255, 255); font-size: 16px; -unity-font-style: bold;"/>
                        <ui:Label name="round-results-best-time-value" text="0:00" style="margin-top: 6px; color: rgb(255, 255, 255); font-size: 26px; -unity-font-style: bold;"/>
                    </ui:VisualElement>
                    <ui:VisualElement style="flex-grow: 1;">
                        <ui:Label text="REVIVES" style="color: rgb(255, 255, 255); font-size: 16px; -unity-font-style: bold;"/>
                        <ui:Label name="round-results-revives-value" text="0" style="margin-top: 6px; color: rgb(122, 255, 125); font-size: 26px; -unity-font-style: bold;"/>
                    </ui:VisualElement>
                    <ui:VisualElement style="flex-grow: 1;">
                        <ui:Label text="DOWNED" style="color: rgb(255, 255, 255); font-size: 16px; -unity-font-style: bold;"/>
                        <ui:Label name="round-results-downed-value" text="0" style="margin-top: 6px; color: rgb(255, 104, 104); font-size: 26px; -unity-font-style: bold;"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Label text="LEADERBOARD" style="margin-top: 22px; color: rgb(255, 255, 255); font-size: 18px; -unity-font-style: bold;"/>
                <ui:ScrollView name="round-results-leaderboard-list" mode="Vertical" vertical-scroller-visibility="Auto" horizontal-scroller-visibility="Hidden" style="margin-top: 10px; min-height: 188px; max-height: 280px; flex-shrink: 1; padding-top: 10px; padding-right: 12px; padding-bottom: 10px; padding-left: 12px; background-color: rgba(255, 255, 255, 0.04); border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-left-radius: 10px; border-bottom-right-radius: 10px;"/>
                <ui:VisualElement style="flex-direction: row; flex-wrap: wrap; justify-content: space-between; align-items: center; margin-top: 16px; row-gap: 10px;">
                    <ui:Label name="round-results-close-hint-label" text="Press Tab, Enter, or Esc to close" style="color: rgba(255, 255, 255, 0.72); font-size: 15px; unity-text-align: middle-left; white-space: normal; flex-grow: 1;"/>
                    <ui:Button name="round-results-exit-button" text="Exit" style="width: 148px; height: 42px; color: rgb(255, 255, 255); background-color: rgb(45, 53, 133); border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-left-radius: 10px; border-bottom-right-radius: 10px; -unity-font-style: bold;"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
