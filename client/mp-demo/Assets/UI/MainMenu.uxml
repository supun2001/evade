            </ui:VisualElement>
            <ui:VisualElement name="shop-preview-panel" style="flex-grow: 1; margin-left: 26px; padding-left: 18px; padding-right: 18px; padding-top: 18px; padding-bottom: 18px; background-color: rgba(7, 14, 19, 0.92); border-top-left-radius: 18px; border-top-right-radius: 18px; border-bottom-left-radius: 18px; border-bottom-right-radius: 18px; justify-content: flex-end;">
