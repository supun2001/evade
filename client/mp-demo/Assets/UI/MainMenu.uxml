<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="main-menu-root" style="flex-grow: 1; position: relative; padding-left: 18px; padding-right: 18px; padding-top: 14px; padding-bottom: 18px; background-color: rgba(3, 10, 18, 0.58);">
        <ui:Label name="menu-version-label" text="Version: 46.7.8" style="position: absolute; left: 50%; top: 18px; translate: -50% 0; color: rgba(255, 255, 255, 0.52); font-size: 13px;"/>
        <ui:VisualElement name="wallet-pill" style="position: absolute; right: 18px; top: 18px; min-width: 168px; padding-left: 16px; padding-right: 16px; padding-top: 10px; padding-bottom: 10px; flex-direction: row; align-items: center; justify-content: space-between; background-color: rgba(14, 22, 18, 0.94); border-left-width: 2px; border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px; border-left-color: rgba(233, 195, 113, 0.65); border-right-color: rgba(233, 195, 113, 0.65); border-top-color: rgba(233, 195, 113, 0.65); border-bottom-color: rgba(233, 195, 113, 0.65); border-top-left-radius: 14px; border-top-right-radius: 14px; border-bottom-left-radius: 14px; border-bottom-right-radius: 14px; z-index: 16;">
            <ui:Label text="CASH" style="color: rgba(255, 245, 224, 0.76); font-size: 14px; -unity-font-style: bold; letter-spacing: 1px;"/>
            <ui:Label name="money-label" text="$100" style="color: rgb(242, 206, 124); font-size: 22px; -unity-font-style: bold; unity-text-align: middle-right;"/>
        </ui:VisualElement>
        <ui:VisualElement name="account-pill" style="position: absolute; left: 18px; top: 18px; min-width: 220px; padding-left: 14px; padding-right: 14px; padding-top: 10px; padding-bottom: 10px; flex-direction: row; align-items: center; justify-content: space-between; background-color: rgba(10, 16, 24, 0.92); border-left-width: 2px; border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px; border-left-color: rgba(255, 255, 255, 0.12); border-right-color: rgba(255, 255, 255, 0.12); border-top-color: rgba(255, 255, 255, 0.12); border-bottom-color: rgba(255, 255, 255, 0.12); border-top-left-radius: 14px; border-top-right-radius: 14px; border-bottom-left-radius: 14px; border-bottom-right-radius: 14px; z-index: 16;">
            <ui:Label name="account-status-label" text="Not logged in" style="flex-grow: 1; color: rgba(255, 255, 255, 0.76); font-size: 15px; -unity-font-style: bold; unity-text-align: middle-left;"/>
        </ui:VisualElement>
        <ui:VisualElement name="menu-center-column" style="flex-grow: 1; align-items: center; justify-content: center; overflow: visible;">
            <ui:VisualElement name="menu-logo-panel" style="padding-left: 34px; padding-right: 34px; padding-top: 20px; padding-bottom: 18px; background-color: rgba(14, 11, 13, 0.82); border-top-left-radius: 20px; border-top-right-radius: 20px; border-bottom-left-radius: 20px; border-bottom-right-radius: 20px;">
                <ui:Label name="menu-logo-label" text="Runner" style="color: rgb(103, 235, 76); font-size: 78px; -unity-font-style: bold; unity-text-align: middle-center; letter-spacing: 8px;"/>
            </ui:VisualElement>
            <ui:Label name="menu-hover-label" text="Pick what you want to do next" style="margin-top: 26px; min-height: 24px; color: rgba(255, 255, 255, 0.88); font-size: 17px; -unity-font-style: bold; unity-text-align: middle-center; opacity: 0;"/>
            <ui:VisualElement name="menu-featured-row" style="flex-direction: row; align-items: flex-end; justify-content: center; margin-top: 18px; overflow: visible;">
                <ui:Button name="shop-button" text="" style="width: 228px; height: 110px; margin-right: 28px; background-color: rgba(16, 24, 20, 0.9); border-left-width: 2px; border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px; border-left-color: rgba(84, 223, 83, 0.72); border-right-color: rgba(84, 223, 83, 0.72); border-top-color: rgba(84, 223, 83, 0.72); border-bottom-color: rgba(84, 223, 83, 0.72); border-top-left-radius: 12px; border-top-right-radius: 12px; border-bottom-left-radius: 12px; border-bottom-right-radius: 12px; transform-origin: center center; padding-left: 0; padding-right: 0; padding-top: 0; padding-bottom: 0; overflow: hidden; position: relative;">
                    <ui:Label name="shop-button-label" text="SHOP" style="position: absolute; left: 12px; right: 12px; bottom: 8px; color: rgb(84, 223, 83); font-size: 24px; -unity-font-style: bold; unity-text-align: lower-left; -unity-text-outline-width: 1px; -unity-text-outline-color: rgba(10, 22, 12, 0.95); pointer-events: none;"/>
                </ui:Button>
                <ui:Button name="start-button" text="" style="width: 302px; height: 144px; background-color: rgba(0, 0, 0, 0.94); border-left-width: 2px; border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px; border-left-color: rgba(239, 186, 101, 0.84); border-right-color: rgba(239, 186, 101, 0.84); border-top-color: rgba(239, 186, 101, 0.84); border-bottom-color: rgba(239, 186, 101, 0.84); border-top-left-radius: 16px; border-top-right-radius: 16px; border-bottom-left-radius: 16px; border-bottom-right-radius: 16px; transform-origin: center center; padding-left: 0; padding-right: 0; padding-top: 0; padding-bottom: 0; overflow: hidden; position: relative;">
                    <ui:Label name="start-button-label" text="JOIN GAME" style="position: absolute; left: 18px; right: 18px; bottom: 10px; color: rgb(232, 186, 103); font-size: 26px; -unity-font-style: bold; unity-text-align: lower-center; letter-spacing: 1px; -unity-text-outline-width: 1px; -unity-text-outline-color: rgba(34, 22, 12, 0.95); pointer-events: none;"/>
                </ui:Button>
                <ui:Button name="inventory-button" text="" style="width: 228px; height: 110px; margin-left: 28px; background-color: rgba(26, 14, 16, 0.9); border-left-width: 2px; border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px; border-left-color: rgba(240, 101, 111, 0.72); border-right-color: rgba(240, 101, 111, 0.72); border-top-color: rgba(240, 101, 111, 0.72); border-bottom-color: rgba(240, 101, 111, 0.72); border-top-left-radius: 12px; border-top-right-radius: 12px; border-bottom-left-radius: 12px; border-bottom-right-radius: 12px; transform-origin: center center; padding-left: 0; padding-right: 0; padding-top: 0; padding-bottom: 0; overflow: hidden; position: relative;">
                    <ui:Label name="inventory-button-label" text="INVENTORY" style="position: absolute; left: 12px; right: 12px; bottom: 8px; color: rgb(240, 101, 111); font-size: 24px; -unity-font-style: bold; unity-text-align: lower-right; -unity-text-outline-width: 1px; -unity-text-outline-color: rgba(30, 12, 16, 0.95); pointer-events: none;"/>
                </ui:Button>
            </ui:VisualElement>
            <ui:VisualElement name="menu-secondary-row" style="flex-direction: row; justify-content: center; margin-top: 22px; overflow: visible;">
                <ui:Button name="spectate-button" text="SPECTATE" style="width: 160px; height: 76px; color: rgb(208, 208, 208); background-color: rgba(18, 18, 20, 0.88); border-left-width: 2px; border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px; border-left-color: rgba(154, 124, 255, 0.5); border-right-color: rgba(154, 124, 255, 0.5); border-top-color: rgba(154, 124, 255, 0.5); border-bottom-color: rgba(154, 124, 255, 0.5); border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-left-radius: 10px; border-bottom-right-radius: 10px; font-size: 18px; -unity-font-style: bold; transform-origin: center center;"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="menu-right-rail" style="position: absolute; right: 14px; top: 50%; translate: 0 -50%; row-gap: 8px; align-items: stretch; overflow: visible; z-index: 10;">
            <ui:Button name="login-button" text="LOGIN" style="width: 118px; height: 56px; color: rgb(255, 255, 255); background-color: rgba(48, 94, 170, 0.96); border-left-width: 2px; border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px; border-left-color: rgba(120, 173, 255, 0.32); border-right-color: rgba(120, 173, 255, 0.32); border-top-color: rgba(120, 173, 255, 0.32); border-bottom-color: rgba(120, 173, 255, 0.32); border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-left-radius: 10px; border-bottom-right-radius: 10px; font-size: 15px; -unity-font-style: bold;"/>
            <ui:Button name="settings-button" text="SETTINGS" style="width: 118px; height: 56px; color: rgb(255, 255, 255); background-color: rgba(8, 12, 18, 0.9); border-left-width: 2px; border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px; border-left-color: rgba(255, 255, 255, 0.18); border-right-color: rgba(255, 255, 255, 0.18); border-top-color: rgba(255, 255, 255, 0.18); border-bottom-color: rgba(255, 255, 255, 0.18); border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-left-radius: 10px; border-bottom-right-radius: 10px; font-size: 15px; -unity-font-style: bold;"/>
        </ui:VisualElement>
        <ui:Button name="offline-button" text="" style="position: absolute; left: 34px; bottom: 34px; width: 228px; height: 110px; background-color: rgba(14, 20, 31, 0.92); border-left-width: 2px; border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px; border-left-color: rgba(104, 182, 255, 0.72); border-right-color: rgba(104, 182, 255, 0.72); border-top-color: rgba(104, 182, 255, 0.72); border-bottom-color: rgba(104, 182, 255, 0.72); border-top-left-radius: 12px; border-top-right-radius: 12px; border-bottom-left-radius: 12px; border-bottom-right-radius: 12px; transform-origin: center center; padding-left: 0; padding-right: 0; padding-top: 0; padding-bottom: 0; overflow: hidden; z-index: 12;">
            <ui:Label name="offline-button-label" text="OFFLINE" style="position: absolute; left: 12px; right: 12px; bottom: 8px; color: rgb(104, 182, 255); font-size: 24px; -unity-font-style: bold; unity-text-align: lower-left; -unity-text-outline-width: 1px; -unity-text-outline-color: rgba(10, 18, 28, 0.95); pointer-events: none;"/>
        </ui:Button>
        <ui:VisualElement name="shop-overlay" style="display: none; position: absolute; left: 0; top: 0; right: 0; bottom: 0; padding-left: 28px; padding-right: 28px; padding-top: 28px; padding-bottom: 28px; flex-direction: row; align-items: stretch; justify-content: space-between; background-color: rgba(0, 0, 0, 0.72); z-index: 25;">
            <ui:VisualElement name="shop-left-panel" style="width: 470px; max-width: 43%; padding-left: 18px; padding-right: 18px; padding-top: 18px; padding-bottom: 18px; background-color: rgba(20, 13, 10, 0.88); border-left-width: 2px; border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px; border-left-color: rgba(80, 52, 34, 0.96); border-right-color: rgba(80, 52, 34, 0.96); border-top-color: rgba(80, 52, 34, 0.96); border-bottom-color: rgba(80, 52, 34, 0.96); border-top-left-radius: 18px; border-top-right-radius: 18px; border-bottom-left-radius: 18px; border-bottom-right-radius: 18px;">
                <ui:VisualElement style="padding-left: 22px; padding-right: 22px; padding-top: 16px; padding-bottom: 16px; background-color: rgba(78, 49, 30, 0.88); border-top-left-radius: 12px; border-top-right-radius: 12px; border-bottom-left-radius: 12px; border-bottom-right-radius: 12px;">
                    <ui:Label text="SHOP" style="color: rgb(255, 231, 211); font-size: 42px; -unity-font-style: bold; unity-text-align: middle-center; letter-spacing: 2px; -unity-text-outline-width: 1px; -unity-text-outline-color: rgba(38, 18, 7, 0.9);"/>
                </ui:VisualElement>
                <ui:VisualElement name="shop-home-view" style="margin-top: 14px; flex-grow: 1; row-gap: 12px;">
                    <ui:Button name="shop-skins-menu-button" text="" style="height: 92px; padding-left: 18px; padding-right: 18px; padding-top: 14px; padding-bottom: 14px; background-color: rgba(18, 18, 18, 0.84); border-left-width: 2px; border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px; border-left-color: rgba(214, 118, 132, 0.78); border-right-color: rgba(214, 118, 132, 0.78); border-top-color: rgba(214, 118, 132, 0.78); border-bottom-color: rgba(214, 118, 132, 0.78); border-top-left-radius: 12px; border-top-right-radius: 12px; border-bottom-left-radius: 12px; border-bottom-right-radius: 12px;">
                        <ui:VisualElement style="flex-direction: row; justify-content: space-between; align-items: center; flex-grow: 1;">
                            <ui:Label text="CHARACTER" style="color: rgb(245, 232, 233); font-size: 23px; -unity-font-style: bold; unity-text-align: middle-left;"/>
                            <ui:Label text="AVATAR" style="color: rgb(214, 118, 132); font-size: 18px; -unity-font-style: bold; unity-text-align: middle-right;"/>
                        </ui:VisualElement>
                    </ui:Button>
                    <ui:Button name="shop-daily-store-button" text="" style="height: 92px; padding-left: 18px; padding-right: 18px; padding-top: 14px; padding-bottom: 14px; background-color: rgba(18, 18, 18, 0.84); border-left-width: 2px; border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px; border-left-color: rgba(214, 118, 132, 0.78); border-right-color: rgba(214, 118, 132, 0.78); border-top-color: rgba(214, 118, 132, 0.78); border-bottom-color: rgba(214, 118, 132, 0.78); border-top-left-radius: 12px; border-top-right-radius: 12px; border-bottom-left-radius: 12px; border-bottom-right-radius: 12px;">
                        <ui:VisualElement style="flex-direction: row; justify-content: space-between; align-items: center; flex-grow: 1;">
                            <ui:Label text="DAILY STORE" style="color: rgb(245, 232, 233); font-size: 23px; -unity-font-style: bold; unity-text-align: middle-left;"/>
                            <ui:Label text="SHOP" style="color: rgb(214, 118, 132); font-size: 18px; -unity-font-style: bold; unity-text-align: middle-right;"/>
                        </ui:VisualElement>
                    </ui:Button>
                    <ui:Button name="shop-equipment-button" text="" style="height: 92px; padding-left: 18px; padding-right: 18px; padding-top: 14px; padding-bottom: 14px; background-color: rgba(18, 18, 18, 0.84); border-left-width: 2px; border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px; border-left-color: rgba(120, 142, 220, 0.78); border-right-color: rgba(120, 142, 220, 0.78); border-top-color: rgba(120, 142, 220, 0.78); border-bottom-color: rgba(120, 142, 220, 0.78); border-top-left-radius: 12px; border-top-right-radius: 12px; border-bottom-left-radius: 12px; border-bottom-right-radius: 12px;">
                        <ui:VisualElement style="flex-direction: row; justify-content: space-between; align-items: center; flex-grow: 1;">
                            <ui:Label text="EQUIPMENT" style="color: rgb(245, 232, 233); font-size: 23px; -unity-font-style: bold; unity-text-align: middle-left;"/>
                            <ui:Label text="WRENCH" style="color: rgb(120, 142, 220); font-size: 18px; -unity-font-style: bold; unity-text-align: middle-right;"/>
                        </ui:VisualElement>
                    </ui:Button>
                    <ui:Button name="shop-emotes-button" text="" style="height: 92px; padding-left: 18px; padding-right: 18px; padding-top: 14px; padding-bottom: 14px; background-color: rgba(18, 18, 18, 0.84); border-left-width: 2px; border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px; border-left-color: rgba(207, 190, 111, 0.78); border-right-color: rgba(207, 190, 111, 0.78); border-top-color: rgba(207, 190, 111, 0.78); border-bottom-color: rgba(207, 190, 111, 0.78); border-top-left-radius: 12px; border-top-right-radius: 12px; border-bottom-left-radius: 12px; border-bottom-right-radius: 12px;">
                        <ui:VisualElement style="flex-direction: row; justify-content: space-between; align-items: center; flex-grow: 1;">
                            <ui:Label text="EMOTES" style="color: rgb(245, 232, 233); font-size: 23px; -unity-font-style: bold; unity-text-align: middle-left;"/>
                            <ui:Label text="EMOTE" style="color: rgb(207, 190, 111); font-size: 18px; -unity-font-style: bold; unity-text-align: middle-right;"/>
                        </ui:VisualElement>
