<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="main-menu-root" style="flex-grow: 1; position: relative; padding-left: 18px; padding-right: 18px; padding-top: 14px; padding-bottom: 18px; background-color: rgba(3, 10, 18, 0.58);">
        <ui:Label name="menu-version-label" text="Version: 46.7.8" style="position: absolute; left: 50%; top: 18px; translate: -50% 0; color: rgba(255, 255, 255, 0.52); font-size: 13px;"/>
        <ui:VisualElement name="menu-center-column" style="flex-grow: 1; align-items: center; justify-content: center; overflow: visible;">
            <ui:VisualElement name="menu-logo-panel" style="padding-left: 34px; padding-right: 34px; padding-top: 20px; padding-bottom: 18px; background-color: rgba(14, 11, 13, 0.82); border-top-left-radius: 20px; border-top-right-radius: 20px; border-bottom-left-radius: 20px; border-bottom-right-radius: 20px;">
                <ui:Label name="menu-logo-label" text="Runner" style="color: rgb(103, 235, 76); font-size: 78px; -unity-font-style: bold; unity-text-align: middle-center; letter-spacing: 8px;"/>
            </ui:VisualElement>
            <ui:Label name="menu-hover-label" text="Pick what you want to do next" style="margin-top: 26px; min-height: 24px; color: rgba(255, 255, 255, 0.88); font-size: 17px; -unity-font-style: bold; unity-text-align: middle-center; opacity: 0;"/>
            <ui:VisualElement name="menu-featured-row" style="flex-direction: row; align-items: flex-end; justify-content: center; margin-top: 18px; overflow: visible;">
                <ui:Button name="shop-button" text="" style="width: 228px; height: 110px; margin-right: 28px; background-color: rgba(16, 24, 20, 0.9); border-left-width: 2px; border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px; border-left-color: rgba(84, 223, 83, 0.72); border-right-color: rgba(84, 223, 83, 0.72); border-top-color: rgba(84, 223, 83, 0.72); border-bottom-color: rgba(84, 223, 83, 0.72); border-top-left-radius: 12px; border-top-right-radius: 12px; border-bottom-left-radius: 12px; border-bottom-right-radius: 12px; transform-origin: center center; padding-left: 0; padding-right: 0; padding-top: 0; padding-bottom: 0; overflow: hidden; position: relative;">
                    <ui:Label name="shop-button-label" text="SHOP" style="position: absolute; left: 12px; right: 12px; bottom: 8px; color: rgb(84, 223, 83); font-size: 24px; -unity-font-style: bold; unity-text-align: lower-left; -unity-text-outline-width: 1px; -unity-text-outline-color: rgba(10, 22, 12, 0.95); pointer-events: none;"/>
                </ui:Button>
                <ui:Button name="start-button" text="" style="width: 302px; height: 144px; background-color: rgba(0, 0, 0, 0.94); border-left-width: 2px; border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px; border-left-color: rgba(239, 186, 101, 0.84); border-right-color: rgba(239, 186, 101, 0.84); border-top-color: rgba(239, 186, 101, 0.84); border-bottom-color: rgba(239, 186, 101, 0.84); border-top-left-radius: 16px; border-top-right-radius: 16px; border-bottom-left-radius: 16px; border-bottom-right-radius: 16px; transform-origin: center center; padding-left: 0; padding-right: 0; padding-top: 0; padding-bottom: 0; overflow: hidden; position: relative;">
                    <ui:Label name="start-button-label" text="JOIN GAME" style="position: absolute; left: 18px; right: 18px; bottom: 10px; color: rgb(232, 186, 103); font-size: 26px; -unity-font-style: bold; unity-text-align: lower-center; letter-spacing: 1px; -unity-text-outline-width: 1px; -unity-text-outline-color: rgba(34, 22, 12, 0.95); pointer-events: none;"/>
                </ui:Button>
                <ui:Button name="inventory-button" text="" style="width: 228px; height: 110px; margin-left: 28px; background-color: rgba(26, 14, 16, 0.9); border-left-width: 2px; border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px; border-left-color: rgba(240, 101, 111, 0.72); border-right-color: rgba(240, 101, 111, 0.72); border-top-color: rgba(240, 101, 111, 0.72); border-bottom-color: rgba(240, 101, 111, 0.72); border-top-left-radius: 12px; border-top-right-radius: 12px; border-bottom-left-radius: 12px; border-bottom-right-radius: 12px; transform-origin: center center; padding-left: 0; padding-right: 0; padding-top: 0; padding-bottom: 0; overflow: hidden; position: relative;">
                    <ui:Label name="inventory-button-label" text="INVENTORY" style="position: absolute; left: 12px; right: 12px; bottom: 8px; color: rgb(240, 101, 111); font-size: 24px; -unity-font-style: bold; unity-text-align: lower-right; -unity-text-outline-width: 1px; -unity-text-outline-color: rgba(30, 12, 16, 0.95); pointer-events: none;"/>
                </ui:Button>
            </ui:VisualElement>
            <ui:VisualElement name="menu-secondary-row" style="flex-direction: row; justify-content: center; margin-top: 22px; overflow: visible;">
                <ui:Button name="spectate-button" text="SPECTATE" style="width: 160px; height: 76px; color: rgb(208, 208, 208); background-color: rgba(18, 18, 20, 0.88); border-left-width: 2px; border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px; border-left-color: rgba(154, 124, 255, 0.5); border-right-color: rgba(154, 124, 255, 0.5); border-top-color: rgba(154, 124, 255, 0.5); border-bottom-color: rgba(154, 124, 255, 0.5); border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-left-radius: 10px; border-bottom-right-radius: 10px; font-size: 18px; -unity-font-style: bold; transform-origin: center center;"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="menu-right-rail" style="position: absolute; right: 14px; top: 50%; translate: 0 -50%; row-gap: 8px; align-items: stretch; overflow: visible; z-index: 10;">
            <ui:Button name="settings-button" text="SETTINGS" style="width: 118px; height: 56px; color: rgb(255, 255, 255); background-color: rgba(8, 12, 18, 0.9); border-left-width: 2px; border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px; border-left-color: rgba(255, 255, 255, 0.18); border-right-color: rgba(255, 255, 255, 0.18); border-top-color: rgba(255, 255, 255, 0.18); border-bottom-color: rgba(255, 255, 255, 0.18); border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-left-radius: 10px; border-bottom-right-radius: 10px; font-size: 15px; -unity-font-style: bold;"/>
        </ui:VisualElement>
        <ui:VisualElement name="graphics-settings-panel" style="display: none; position: absolute; left: 0; top: 0; right: 0; bottom: 0; align-items: center; justify-content: center; background-color: rgba(0, 0, 0, 0.42); z-index: 20;">
            <ui:VisualElement name="settings-card" style="width: 420px; max-width: 90%; padding-left: 24px; padding-right: 24px; padding-top: 22px; padding-bottom: 22px; background-color: rgba(12, 18, 26, 0.97); border-top-left-radius: 18px; border-top-right-radius: 18px; border-bottom-left-radius: 18px; border-bottom-right-radius: 18px; border-left-width: 1px; border-right-width: 1px; border-top-width: 1px; border-bottom-width: 1px; border-left-color: rgba(255,255,255,0.08); border-right-color: rgba(255,255,255,0.08); border-top-color: rgba(255,255,255,0.08); border-bottom-color: rgba(255,255,255,0.08);">
                <ui:VisualElement style="flex-direction: row; justify-content: space-between; align-items: center;">
                    <ui:Label text="SETTINGS" style="font-size: 26px; -unity-font-style: bold; color: rgb(255, 255, 255); letter-spacing: 1px;"/>
                    <ui:Button name="settings-close-button" text="X" style="width: 40px; height: 40px; color: rgb(255,255,255); background-color: rgba(34, 40, 50, 0.95); border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-left-radius: 10px; border-bottom-right-radius: 10px; -unity-font-style: bold;"/>
                </ui:VisualElement>
                <ui:Label text="Audio" style="margin-top: 18px; font-size: 20px; -unity-font-style: bold; color: rgb(255,255,255);"/>
                <ui:VisualElement style="margin-top: 12px; padding-left: 14px; padding-right: 14px; padding-top: 14px; padding-bottom: 14px; background-color: rgba(45, 49, 57, 0.92); border-top-left-radius: 12px; border-top-right-radius: 12px; border-bottom-left-radius: 12px; border-bottom-right-radius: 12px;">
                    <ui:Label text="Volume" style="color: rgb(255,255,255); font-size: 16px;"/>
                    <ui:SliderInt name="graphics-volume-slider" low-value="0" high-value="10" page-size="1" show-input-field="false" style="margin-top: 8px;"/>
                </ui:VisualElement>
                <ui:Label text="Graphics" style="margin-top: 18px; font-size: 20px; -unity-font-style: bold; color: rgb(255,255,255);"/>
                <ui:Label name="graphics-current-label" text="Current: Medium" style="margin-top: 6px; font-size: 13px; color: rgba(255, 255, 255, 0.65);"/>
                <ui:VisualElement style="flex-direction: row; margin-top: 14px;">
                    <ui:Button name="graphics-low-button" text="LOW" style="flex-grow: 1; height: 48px; margin-right: 6px; color: rgb(255, 255, 255); background-color: rgba(58, 92, 44, 0.95); border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-left-radius: 10px; border-bottom-right-radius: 10px; font-size: 16px; -unity-font-style: bold;"/>
                    <ui:Button name="graphics-medium-button" text="MEDIUM" style="flex-grow: 1; height: 48px; margin-left: 6px; color: rgb(255, 255, 255); background-color: rgba(67, 84, 122, 0.95); border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-left-radius: 10px; border-bottom-right-radius: 10px; font-size: 16px; -unity-font-style: bold;"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="coming-soon-overlay" style="display: none; position: absolute; left: 0; top: 0; right: 0; bottom: 0; align-items: center; justify-content: center; background-color: rgba(0, 0, 0, 0.4); z-index: 30;">
            <ui:VisualElement name="coming-soon-card" style="width: 360px; max-width: 86%; padding-left: 26px; padding-right: 26px; padding-top: 24px; padding-bottom: 22px; background-color: rgba(12, 18, 26, 0.96); border-left-width: 1px; border-right-width: 1px; border-top-width: 1px; border-bottom-width: 1px; border-left-color: rgba(255,255,255,0.08); border-right-color: rgba(255,255,255,0.08); border-top-color: rgba(255,255,255,0.08); border-bottom-color: rgba(255,255,255,0.08); border-top-left-radius: 16px; border-top-right-radius: 16px; border-bottom-left-radius: 16px; border-bottom-right-radius: 16px; align-items: stretch;">
                <ui:Label name="coming-soon-title-label" text="COMING SOON" style="color: rgb(255, 241, 204); font-size: 28px; -unity-font-style: bold; unity-text-align: middle-center; letter-spacing: 1px;"/>
                <ui:Label name="coming-soon-message-label" text="This feature is still being built." style="margin-top: 12px; color: rgba(255,255,255,0.82); font-size: 17px; unity-text-align: middle-center; white-space: normal;"/>
                <ui:Button name="coming-soon-close-button" text="OK" style="height: 48px; margin-top: 22px; color: rgb(255,255,255); background-color: rgba(45, 97, 176, 0.95); border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-left-radius: 10px; border-bottom-right-radius: 10px; font-size: 18px; -unity-font-style: bold;"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
