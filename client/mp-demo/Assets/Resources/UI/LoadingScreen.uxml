<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="loading-root" style="flex-grow: 1; position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgb(7, 9, 12); align-items: center; justify-content: center;">
        <!-- Background Image with Overlay -->
        <ui:VisualElement style="position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-image: url(&apos;project://database/Assets/Resources/UI/LoadingBG.png&apos;); -unity-background-scale-mode: scale-and-crop; opacity: 0.4;" />
        <ui:VisualElement style="position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgba(7, 9, 12, 0.6);" />

        <!-- Background Glow -->
        <ui:VisualElement style="position: absolute; width: 600px; height: 600px; background-color: rgba(232, 186, 103, 0.03); border-top-left-radius: 300px; border-top-right-radius: 300px; border-bottom-left-radius: 300px; border-bottom-right-radius: 300px; translate: 0 -50px;" />
        
        <ui:VisualElement name="loading-container" style="align-items: center; justify-content: center; width: 100%;">
            <!-- Logo/Title Section -->
            <ui:VisualElement style="margin-bottom: 70px; align-items: center;">
                <ui:Label text="E V A D E" style="color: rgb(255, 255, 255); font-size: 96px; -unity-font-style: bold; letter-spacing: 24px; -unity-text-outline-width: 1px; -unity-text-outline-color: rgba(232, 186, 103, 0.4);" />
                <ui:Label text="PREPARING YOUR ESCAPE" style="color: rgba(232, 186, 103, 0.85); font-size: 19px; -unity-font-style: bold; letter-spacing: 9px; margin-top: -12px;" />
            </ui:VisualElement>

            <!-- Loading Bar Section -->
            <ui:VisualElement style="width: 580px; align-items: stretch;">
                <ui:VisualElement style="flex-direction: row; justify-content: space-between; margin-bottom: 14px; padding-left: 6px; padding-right: 6px;">
                    <ui:Label name="loading-status" text="INITIALIZING..." style="color: rgba(255, 255, 255, 0.65); font-size: 15px; -unity-font-style: bold; letter-spacing: 2px;" />
                    <ui:Label name="loading-percent" text="0%" style="color: rgb(232, 186, 103); font-size: 15px; -unity-font-style: bold;" />
                </ui:VisualElement>
                
                <ui:VisualElement name="loading-bar-bg" style="height: 3px; background-color: rgba(255, 255, 255, 0.08); border-top-left-radius: 2px; border-top-right-radius: 2px; border-bottom-left-radius: 2px; border-bottom-right-radius: 2px; overflow: hidden;">
                    <ui:VisualElement name="loading-bar-fill" style="width: 0%; height: 100%; background-color: rgb(232, 186, 103);" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Bottom Decoration -->
        <ui:VisualElement style="position: absolute; bottom: 50px; flex-direction: row; align-items: center;">
            <ui:VisualElement style="width: 120px; height: 1px; background-color: rgba(232, 186, 103, 0.15);" />
            <ui:Label name="loading-tip" text="TIP: STAY IN GROUPS TO SURVIVE LONGER" style="margin-left: 24px; margin-right: 24px; color: rgba(255, 255, 255, 0.25); font-size: 13px; letter-spacing: 3px;" />
            <ui:VisualElement style="width: 120px; height: 1px; background-color: rgba(232, 186, 103, 0.15);" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
